// Confeitaria App — Schema do banco de dados
// PostgreSQL + Prisma

generator client {
  provider = "prisma-client-js"
}

// DATABASE_URL: Transaction Pooler do Supabase (porta 6543, ?pgbouncer=true) —
// usado pela aplicação em runtime (Vercel serverless). DIRECT_URL: Session
// Pooler (porta 5432) — usado só por `prisma migrate`/`db push`, que exigem
// conexão com estado de sessão (DDL não funciona em modo transação do
// pooler). Sprint de infraestrutura (08/09/2026): produção estava com
// DATABASE_URL apontando para o Session Pooler (porta 5432) também em
// runtime — pool_size:15 do modo sessão esgotava com a concorrência normal
// de funções serverless, causando "FATAL: max clients reached in session
// mode" em toda rota da API. Ver CHANGELOG.md.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN
  ATENDIMENTO
  PRODUCAO
  FINANCEIRO
}

enum DeliveryType {
  RETIRADA // Cliente retira — sem custo
  ENTREGA_APP // Uber / 99 — pago pelo cliente
  ENTREGA_GRATIS // Até 3 km — custo da confeitaria
}

enum PaymentMethod {
  PIX_ONLINE // PIX integrado no checkout
  PIX_ENTREGA
  DINHEIRO
  CARTAO_CREDITO
}

enum PaymentStatus {
  PENDENTE
  PAGO
  PARCIAL
  ESTORNADO
}

enum OrderStatus {
  RASCUNHO
  CONFIRMADO
  EM_PRODUCAO
  PRONTO
  SAIU_ENTREGA
  ENTREGUE
  CANCELADO
}

enum PriceSource {
  MANUAL
  CONAB_CEASA
  CEPEA
  NOTA_FISCAL
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA
}

enum UnitType {
  MASS
  VOLUME
  UNIT
}

// ─── Configuração da loja ────────────────────────────────────────────────────

model StoreConfig {
  id String @id @default(cuid())

  // Identificação
  name      String  @default("Confeitaria Artesanal")
  legalName String? // Razão social — usada em DRE e NFe (Fase 7)
  cnpj      String? // 14 dígitos — integrações fiscais (Fase 7)

  // Contato
  phone     String?
  email     String?
  instagram String? // Ex: @doceatelier

  // Endereço base — usado no cálculo de raio de entrega gratuita
  addressStreet       String?
  addressNumber       String?
  addressComplement   String? // Sala, bloco, andar etc.
  addressNeighborhood String?
  addressCity         String  @default("São Paulo")
  addressState        String  @default("SP")
  addressZip          String?
  ibgeCode            String? // Código IBGE do município — NFe e integrações fiscais (Fase 7)
  latitude            Float? // Preenchido via geocodificação (Fase P3.8)
  longitude           Float? // Preenchido via geocodificação (Fase P3.8)

  // Entrega
  freeDeliveryRadiusKm Float @default(3)

  // PIX — instruções para recebimento
  pixKeyType PixKeyType?
  pixKey     String?

  // Precificação
  laborCostPerHour       Decimal @default(35) @db.Decimal(10, 2)
  fixedCostMonthly       Decimal @default(0) @db.Decimal(12, 2)
  monthlyProductionUnits Int     @default(200)
  monthlyProductionMinutes Int   @default(6000) // capacidade produtiva mensal em minutos — base do rateio de custo fixo por tempo de preparo (Módulo P3.1)
  targetMarginPercent    Decimal @default(50) @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ThemeConfig {
  id              String   @id @default(cuid())
  name            String   @default("Doce Atelier")
  primaryColor    String   @default("#E8A598")
  secondaryColor  String   @default("#3D2B1F")
  backgroundColor String   @default("#FAF7F2")
  accentColor     String   @default("#7A9E7E")
  logoUrl         String?
  faviconUrl      String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─── Usuários internos (equipe) ──────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(ATENDIMENTO)
  active       Boolean  @default(true)
  orders       Order[]  @relation("OrderCreatedBy")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ─── Clientes (chave: celular) ───────────────────────────────────────────────

model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique // DDD + número — chave de identificação
  email     String?
  notes     String? // Notas internas da equipe
  addresses Address[]
  orders    Order[]
  otpCodes  OtpCode[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Address {
  id           String   @id @default(cuid())
  customerId   String
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label        String? // "Casa", "Trabalho"
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String   @default("São Paulo")
  state        String   @default("SP")
  zipCode      String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  orders       Order[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([customerId])
}

model OtpCode {
  id         String    @id @default(cuid())
  customerId String?
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String
  code       String
  attempts   Int       @default(0) // máximo de 3 tentativas de validação — Regra 15.5, REGRAS_NEGOCIO.md
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, code])
}

// ─── Unidades de medida ──────────────────────────────────────────────────────

model UnitOfMeasure {
  id              String             @id @default(cuid())
  name            String             @unique // "grama", "quilograma"
  abbreviation    String             @unique // "g", "kg"
  type            UnitType // MASS, VOLUME, UNIT
  sortOrder       Int                @default(0) // Menor valor = exibido primeiro.
  isActive        Boolean            @default(true)
  ingredients     Ingredient[]
  recipeItems     RecipeIngredient[]
  conversionsFrom UnitConversion[]   @relation("ConversionsFrom")
  conversionsTo   UnitConversion[]   @relation("ConversionsTo")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model UnitConversion {
  id          String        @id @default(cuid())
  fromUnitId  String
  fromUnit    UnitOfMeasure @relation("ConversionsFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnitId    String
  toUnit      UnitOfMeasure @relation("ConversionsTo", fields: [toUnitId], references: [id], onDelete: Restrict)
  factor      Decimal       @db.Decimal(18, 8) // ex: 1 kg = 1000 g → factor = 1000
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([fromUnitId, toUnitId])
}

// ─── Fornecedores ────────────────────────────────────────────────────────────
// Módulo 2.E — entidade isolada na sprint de origem, sem relacionamento com
// Ingredient (decisão arquitetural registrada em CHANGELOG.md, Sprint 2.E.1:
// migração de Ingredient.supplier para FK fica para uma sprint dedicada, para
// não reabrir o Módulo 2.G já encerrado sem Ordem de Missão específica).
// Ganhou relação real com Packaging na Sprint 2.H.1 (Módulo 2.H, ADR-014).

model Supplier {
  id           String      @id @default(cuid())
  name         String
  phone        String?
  cnpj         String?     @unique
  leadTimeDays Int? // prazo médio de entrega em dias — mesmo padrão de Product.leadTimeDays
  notes        String? // condições de pagamento, mínimo de compra etc. (texto livre)
  active       Boolean     @default(true)
  packagings   Packaging[] // relação inversa — Módulo 2.H (Sprint 2.H.1), aditiva, nenhum campo existente alterado
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([name])
}

// ─── Insumos e histórico de preços ───────────────────────────────────────────

model IngredientCategory {
  id          String       @id @default(cuid())
  name        String       @unique
  ingredients Ingredient[]
}

model Ingredient {
  id             String                   @id @default(cuid())
  name           String
  categoryId     String?
  category       IngredientCategory?      @relation(fields: [categoryId], references: [id])
  unitId         String
  unit           UnitOfMeasure            @relation(fields: [unitId], references: [id])
  currentPrice   Decimal                  @db.Decimal(12, 4)
  stockQuantity  Decimal                  @default(0) @db.Decimal(12, 4)
  minStock       Decimal                  @default(0) @db.Decimal(12, 4)
  supplier       String?
  externalCode   String? // Código CONAB/CEASA para sync
  externalSource PriceSource?
  active         Boolean                  @default(true)
  priceHistory   IngredientPriceHistory[]
  recipeItems    RecipeIngredient[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([name])
  @@index([categoryId])
}

model IngredientPriceHistory {
  id            String      @id @default(cuid())
  ingredientId  String
  ingredient    Ingredient  @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  price         Decimal     @db.Decimal(12, 4)
  source        PriceSource @default(MANUAL)
  notes         String?
  nfceAccessKey String?     // Chave de acesso (44 dígitos) da NFC-e de origem (Módulo 5.E)
  recordedAt    DateTime    @default(now())

  @@index([ingredientId, recordedAt])
  @@unique([ingredientId, nfceAccessKey]) // Uma nota pode gerar várias linhas (1 por item/ingrediente), mas não duas vezes para o mesmo ingrediente
}

// ─── Receitas ────────────────────────────────────────────────────────────────

model Recipe {
  id              String             @id @default(cuid())
  name            String
  description     String?
  yieldQuantity   Decimal            @db.Decimal(10, 2) // rendimento
  yieldUnit       String // "bolo 25cm", "unidade"
  prepTimeMinutes Int                @default(0)
  items           RecipeIngredient[]
  products        ProductRecipe[]
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model RecipeIngredient {
  id           String        @id @default(cuid())
  recipeId     String
  recipe       Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient    @relation(fields: [ingredientId], references: [id])
  quantity     Decimal       @db.Decimal(12, 4)
  unitId       String
  unit         UnitOfMeasure @relation(fields: [unitId], references: [id])

  @@unique([recipeId, ingredientId])
}

// ─── Catálogo de produtos ──────────────────────────────────────────────────────

model ProductCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  sortOrder Int       @default(0) // Menor valor = exibido primeiro.
  color     String    @default("#E8A598")
  icon      String    @default("package")
  isActive  Boolean   @default(true)
  products  Product[]
}

model OccasionTag {
  id        String            @id @default(cuid())
  name      String            @unique
  slug      String            @unique
  sortOrder Int               @default(0)
  color     String            @default("#E8A598")
  icon      String            @default("calendar")
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  products  ProductOccasion[]
}

model Product {
  id           String             @id @default(cuid())
  name         String
  description  String?
  categoryId   String
  category     ProductCategory    @relation(fields: [categoryId], references: [id])
  imageUrl     String?
  basePrice    Decimal            @db.Decimal(10, 2)
  costPrice    Decimal            @default(0) @db.Decimal(10, 2) // calculado das receitas
  leadTimeDays Int                @default(2) // prazo mínimo por produto
  active       Boolean            @default(true)
  featured     Boolean            @default(false)
  recipes      ProductRecipe[]
  packagings   ProductPackaging[] // relação inversa — Módulo 2.H (Sprint 2.H.1), aditiva, nenhum campo existente alterado
  occasions    ProductOccasion[]
  orderItems   OrderItem[]
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([categoryId, active])
}

model ProductRecipe {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  recipeId  String
  recipe    Recipe  @relation(fields: [recipeId], references: [id])
  quantity  Decimal @default(1) @db.Decimal(6, 2)

  @@unique([productId, recipeId])
}

model ProductOccasion {
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasionId String
  occasion   OccasionTag @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
}

// ─── Embalagens ──────────────────────────────────────────────────────────────
// Módulo 2.H — entidade própria, separada de Ingredient (decisão de 30/06/2026).
// Vincula-se a Product via ProductPackaging, não a Recipe (ADR-014, CLAUDE.md —
// supera a formulação original que previa PackagingItem vinculado a Recipe; o
// Módulo 2.I foi encerrado sem essa relação). Ver MODULE_2H_PLANNING.md.

model PackagingCategory {
  id         String      @id @default(cuid())
  name       String      @unique
  packagings Packaging[]
}

model Packaging {
  id            String                  @id @default(cuid())
  name          String
  categoryId    String?
  category      PackagingCategory?      @relation(fields: [categoryId], references: [id])
  unitCost      Decimal                 @db.Decimal(12, 4)
  stockQuantity Int                     @default(0)
  minStock      Int                     @default(0)
  supplierId    String?
  supplier      Supplier?               @relation(fields: [supplierId], references: [id])
  active        Boolean                 @default(true)
  priceHistory  PackagingPriceHistory[]
  products      ProductPackaging[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@index([name])
  @@index([categoryId])
}

model PackagingPriceHistory {
  id          String    @id @default(cuid())
  packagingId String
  packaging   Packaging @relation(fields: [packagingId], references: [id], onDelete: Cascade)
  price       Decimal   @db.Decimal(12, 4)
  notes       String?
  recordedAt  DateTime  @default(now())

  @@index([packagingId, recordedAt])
}

model ProductPackaging {
  id          String    @id @default(cuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  packagingId String
  packaging   Packaging @relation(fields: [packagingId], references: [id])
  quantity    Int       @default(1)

  @@unique([productId, packagingId])
}

// ─── Pedidos ───────────────────────────────────────────────────────────────────

model Order {
  id                 String               @id @default(cuid())
  orderNumber        Int                  @unique @default(autoincrement())
  customerId         String
  customer           Customer             @relation(fields: [customerId], references: [id])
  status             OrderStatus          @default(CONFIRMADO)
  deliveryType       DeliveryType
  deliveryDate       DateTime             @db.Date
  deliveryTimeSlot   String? // "14:00-16:00"
  addressId          String?
  address            Address?             @relation(fields: [addressId], references: [id])
  receiverName       String
  receiverPhone      String?
  deliveryFee        Decimal              @default(0) @db.Decimal(10, 2)
  deliveryDistanceKm Float?
  subtotal           Decimal              @db.Decimal(10, 2)
  total              Decimal              @db.Decimal(10, 2)
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus        @default(PENDENTE)
  pixTxId            String? // ID transação PIX integrado
  orderNotes         String? // Observações gerais do pedido
  createdById        String?
  createdBy          User?                @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items              OrderItem[]
  attachments        OrderAttachment[]
  statusHistory      OrderStatusHistory[]
  whatsappLogs       WhatsAppLog[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([customerId])
  @@index([deliveryDate, status])
  @@index([status])
}

model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  order       Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  productName String // snapshot do nome no momento do pedido
  quantity    Int
  unitPrice   Decimal @db.Decimal(10, 2)
  totalPrice  Decimal @db.Decimal(10, 2)
  observation String? // Personalização por produto (MVP)

  @@index([orderId])
}

model OrderAttachment {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fileUrl   String
  fileName  String?
  mimeType  String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  notes     String?
  changedAt DateTime    @default(now())

  @@index([orderId])
}

// ─── WhatsApp ──────────────────────────────────────────────────────────────────

model WhatsAppLog {
  id       String   @id @default(cuid())
  orderId  String?
  order    Order?   @relation(fields: [orderId], references: [id])
  phone    String
  message  String
  template String? // "order_confirmed", "order_ready", etc.
  sentAt   DateTime @default(now())
  success  Boolean  @default(true)
  error    String?

  @@index([orderId])
  @@index([phone])
}
