# DATABASE_URL: usada pela aplicação em runtime — em produção (Supabase),
# deve ser o Transaction Pooler (porta 6543, com ?pgbouncer=true no final).
# DIRECT_URL: usada só por `prisma migrate`/`db push` — em produção, deve ser
# o Session Pooler ou a conexão direta (porta 5432, sem ?pgbouncer=true).
# Em desenvolvimento local (Postgres direto, sem pooler), as duas podem
# apontar para a mesma URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/confeitaria"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/confeitaria"

# Auth equipe
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp (Z-API, Evolution API ou similar)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_INSTANCE_ID=""

# PIX (Mercado Pago, Asaas, PagSeguro...)
PIX_PROVIDER="asaas"
PIX_API_KEY=""
PIX_WEBHOOK_SECRET=""

# Google Maps — cálculo de distância real de entrega (raio em StoreConfig.freeDeliveryRadiusKm)
# Exige projeto no Google Cloud com faturamento ativo e a "Routes API" habilitada
# (não a "Distance Matrix API" — está em modo legado)
GOOGLE_MAPS_API_KEY=""

# Supabase Storage — upload de logomarca e favicon em /admin/config
# SUPABASE_URL: URL do projeto (ex: https://abc123.supabase.co)
# SUPABASE_SERVICE_ROLE_KEY: chave service_role do projeto (Settings → API)
# Criar bucket "store-assets" com acesso público no painel Supabase
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Upload de imagens (legado — substituído pelas variáveis Supabase acima)
STORAGE_BUCKET_URL=""
